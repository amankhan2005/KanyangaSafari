# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://localhost:27017/kanyanga
# Comma-separated list of origins allowed to call the API (the React app)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a proxy/load balancer (for correct client IPs in rate limiting)
TRUST_PROXY=0
