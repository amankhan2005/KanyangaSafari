# Kanyanga Safari — environment variables. Never commit real values.
# Each app reads its own file: copy the client block to client/.env and the server block to server/.env
# (see client/.env.example and server/.env.example). In production, set them in each host's dashboard.

# ── client/.env  (Vite; build-time, public — never put secrets here) ─────────────────────────────
# Public URL of the Express API, no trailing slash. Empty = same origin (/api), e.g. via the Netlify proxy.
VITE_API_URL=
# Development only: where the Vite dev server proxies /api.
VITE_DEV_API_PROXY=http://localhost:4000

# ── server/.env  (Express) ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# MongoDB connection string (Atlas or self-hosted). Stores form submissions only.
MONGODB_URI=mongodb://localhost:27017/kanyanga
# Comma-separated origins allowed to call the API — add the Netlify site URL and custom domain in production.
CLIENT_ORIGIN=http://localhost:5173
# 1 when running behind a proxy/load balancer (most Node hosts), so rate limiting sees real client IPs.
TRUST_PROXY=0
